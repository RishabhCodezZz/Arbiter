# Virtual environment
.venv/
venv/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Trained model + real transaction data — regenerated from Kaggle, never committed.
# See artifacts/README.md for exactly what goes here and how to get it.
artifacts/*
!artifacts/README.md

# Runtime state — audit log and client-history store contain real transaction feature
# vectors (from artifacts/sample_transactions.json), generated by running the engine,
# not source. Never committed, per PLAN.md §8 ("no secrets, no keys, no data files").
data/

# LLM-benchmark checkpoint/progress files — working state, not a deliverable.
# docs/experiments.md, the two PNGs, and docs/llm_benchmark_results.json ARE committed —
# they're real evidence, not scratch.
docs/llm_benchmark_progress_*.jsonl

# Secrets — never committed, even by accident. This project's API keys are set as
# environment variables (OLLAMA_API_KEY, ANTHROPIC_API_KEY), never written to a file.
.env
*.env

# Local-only planning notes not meant for the public repo (e.g. the pitch video's
# script/shot structure) — kept on this machine only.
private/

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/

# Claude Code local tooling — skills (e.g. the clue/ ML-strategy skill), settings, etc.
# Personal dev tooling, not project source; same reasoning as private/ above.
.claude/

# Streamlit local state
.streamlit/
